  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\RTD Check 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F932CD5D-A9A7-4F82-B8A9-E6E55E151AAE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RTD Check 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6877068D-9769-4864-833E-AA82E18BCA68}"
          SQLTask:SqlStatementSource="-- 20220729&#xA;&#xA;IF EXISTS &#xA;&#x9;(&#xA;&#x9;SELECT [name] &#xA;&#x9;FROM [sys].[sysobjects] &#xA;&#x9;WHERE [name] = 'AMOS_RTD_Error_Log'&#xA;&#x9;)&#xA;&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;PRINT 'Exists'&#xA;&#x9;END &#xA;ELSE&#xA;&#x9;BEGIN&#xA;&#x9;PRINT 'not Exists'&#xA;&#x9;CREATE TABLE [dbo].[AMOS_RTD_Error_Log](&#xA;&#x9;&#x9;[Id] [BIGINT] NOT NULL,&#xA;&#x9;&#x9;[AccountId] [INT] NULL,&#xA;&#x9;&#x9;[IntegrationState] [TINYINT] NOT NULL,&#xA;&#x9;&#x9;[LeaseWaveEventLogId] [BIGINT] NOT NULL,&#xA;&#x9;&#x9;[LogTime] [DATETIME2](7) NOT NULL,&#xA;&#x9;&#x9;[Message] [NVARCHAR](MAX) NULL,&#xA;&#x9;&#x9;[HourDiff] [INT] NULL,&#xA;&#x9;&#x9;LoadTime SMALLDATETIME &#xA;&#x9;)&#xA;&#x9;END&#xA;PRINT 'Done'&#xA;&#xA;INSERT INTO LW_AMOS.dbo.AMOS_RTD_Error_Log&#xA;SELECT *&#xA;,DATEDIFF(HOUR,LogTime,GETDATE()) HourDiff&#xA;,CAST(GETDATE() AS SMALLDATETIME) LoadTime&#xA;&#xA;FROM [AMOSInternalApi].[dbo].[LeaseWaveIntegrationLogs]&#xA;WHERE LogTime IN &#xA;(&#xA;SELECT MAX(LogTime) maxLogTime&#xA;FROM [AMOSInternalApi].[dbo].[LeaseWaveIntegrationLogs]&#xA;)&#xA;/*&#xA;SELECT * &#xA;FROM LW_AMOS.dbo.AMOS_RTD_Error_Log&#xA;ORDER BY LogTime DESC &#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\RTD Check 2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{15FED5C1-EC82-46B0-8E53-74ED1CEFEE5F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RTD Check 2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6877068D-9769-4864-833E-AA82E18BCA68}"
          SQLTask:SqlStatementSource="/*-- 20220727&#xA;SELECT *&#xA;, DATEDIFF(HOUR,LogTime,GETDATE()) HourDiff&#xA;INTO LW_AMOS.dbo.AMOS_RTD_Error_Log&#xA;FROM [AMOSInternalApi].[dbo].[LeaseWaveIntegrationLogs]&#xA;WHERE LogTime IN &#xA;(&#xA;SELECT MAX(LogTime) maxLogTime&#xA;FROM [AMOSInternalApi].[dbo].[LeaseWaveIntegrationLogs]&#xA;)&#xA;*/&#xA;&#xA;DECLARE @flag TINYINT&#xA;SELECT &#xA; --DATEDIFF(HOUR,MAX(LogTime),GETDATE()) Diff,&#xA; @flag = CASE&#xA; WHEN DATEDIFF(HOUR,MAX(LogTime),GETDATE()) &lt; 0 THEN 1 &#xA; WHEN DATEDIFF(HOUR,MAX(LogTime),GETDATE()) &gt; 18 THEN 0 &#xA; ELSE 1&#xA; END &#xA;  FROM [AMOSInternalApi].[dbo].[LeaseWaveIntegrationLogs]&#xA;&#xA;PRINT @flag &#xA;&#xA;IF @flag = 1&#xA; BEGIN&#xA; PRINT 'Pass'&#xA;&#xA; EXEC msdb.dbo.sp_send_dbmail  &#xA;     @profile_name = 'DBA_maint',  &#xA;     @recipients = 'ccrespo@insightinvestments.com',  &#xA;     @body = 'Pass, More than 18 hours since the last RTD json was saved in the AMOS production database.',&#xA;  @subject = 'Please review RTD in production'&#xA;&#xA; END &#xA;ELSE&#xA; BEGIN &#xA; PRINT 'Fail'&#xA;&#xA; EXEC msdb.dbo.sp_send_dbmail  &#xA;     @profile_name = 'DBA_maint',  &#xA;     @recipients = 'mdraganza@insightinvestments.com;ccampbell@insightinvestments.com;ccrespo@insightinvestments.com',  &#xA;     @body = 'More than 18 hours since the last RTD json was saved in the AMOS production database.',&#xA;  @subject = 'Please review RTD in production'&#xA; END &#xA;&#xA;--" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
